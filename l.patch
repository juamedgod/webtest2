diff --git a/Dockerfile b/Dockerfile
index b3e8e76..27c1481 100644
--- a/Dockerfile
+++ b/Dockerfile
@@ -1,7 +1,7 @@
-FROM bitnami/ruby:2.6.6-debian-10-r29
+FROM bitnamilegacy/ruby:3.4.5-debian-12-r3
 
 # Deploying requirements
-RUN install_packages rsync openssh-client
+RUN install_packages rsync
 
 # Ruby base template
 COPY Gemfile* /app/
@@ -9,6 +9,6 @@ COPY vendor/cache /app/vendor/cache
 WORKDIR /app
 
 # Install all the dependencies
-RUN gem install bundler --version 1.17.3 && bundle install
+RUN gem install bundler --version 2.6.9 && bundle install
 
 CMD ["irb"]
diff --git a/Gemfile b/Gemfile
index 94d946e..ca1fc5b 100644
--- a/Gemfile
+++ b/Gemfile
@@ -4,7 +4,7 @@ source 'https://rubygems.org'
 
 #gem 'tilt', '~> 2.0.1'
 
-gem 'middleman', github: 'Bitnami/middleman', branch: 'v3-stable'
+gem 'middleman'
 #gem 'middleman-core', github: 'middleman', branch: 'v3-stable'
 gem 'middleman-deploy'
 
@@ -28,9 +28,9 @@ gem 'wdm', '~> 0.1.0', :platforms => [:mswin, :mingw]
 gem 'rubyzip', '>= 1.0.0'
 
 # Activate support for AsciiDoc
-gem 'asciidoctor', '~> 1.5.0'
+gem 'asciidoctor'
 #gem 'middleman-asciidoc', github: 'Bitnami/middleman-asciidoc'
-gem 'asciidoctor-pdf', github: 'Bitnami/asciidoctor-pdf'
+gem 'asciidoctor-pdf', '~> 2.3'
 
 # JS engine
 gem 'therubyracer'
